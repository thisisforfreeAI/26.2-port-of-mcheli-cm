classTweaker v2 official
# Mirrors src/main/resources/META-INF/accesstransformer.cfg (the NeoForge build's access transformer).
# The pilot's eye stays fixed in the cockpit as the vehicle tilts (AircraftCameraClient#placeCockpitEye).
accessible method net/minecraft/client/Camera setPosition (Lnet/minecraft/world/phys/Vec3;)V
# Reuse vanilla chunk delivery and watch events for the bounded UAV camera area.
accessible method net/minecraft/server/level/ChunkMap markChunkPendingToSend (Lnet/minecraft/server/level/ServerPlayer;Lnet/minecraft/world/level/ChunkPos;)V
accessible method net/minecraft/server/level/ChunkMap dropChunk (Lnet/minecraft/server/level/ServerPlayer;Lnet/minecraft/world/level/ChunkPos;)V
accessible method net/minecraft/server/level/ChunkMap applyChunkTrackingView (Lnet/minecraft/server/level/ServerPlayer;Lnet/minecraft/server/level/ChunkTrackingView;)V
# GameTests check which players a vehicle is sent to (LongDistanceTracking).
accessible field net/minecraft/server/level/ChunkMap entityMap Lit/unimi/dsi/fastutil/ints/Int2ObjectMap;
accessible class net/minecraft/server/level/ChunkMap$TrackedEntity
accessible field net/minecraft/server/level/ChunkMap$TrackedEntity seenBy Ljava/util/Set;
accessible field net/minecraft/client/renderer/LevelRenderer levelRenderState Lnet/minecraft/client/renderer/state/level/LevelRenderState;
# Shared client code calls methods NeoForge patches in; the Fabric build injects them (platform/fabric/inject).
inject-interface net/minecraft/client/gui/GuiGraphicsExtractor io/github/mcheliceport/platform/fabric/inject/GuiGraphicsExtras
inject-interface net/minecraft/client/MouseHandler io/github/mcheliceport/platform/fabric/inject/MouseHandlerExtras
inject-interface net/minecraft/client/KeyMapping io/github/mcheliceport/platform/fabric/inject/KeyMappingExtras
accessible class net/minecraft/client/gui/GuiGraphicsExtractor$ScissorStack
# The aircraft camera switches vanilla post effects (NeoForge makes setPostEffect public).
accessible method net/minecraft/client/renderer/GameRenderer setPostEffect (Lnet/minecraft/resources/Identifier;)V
